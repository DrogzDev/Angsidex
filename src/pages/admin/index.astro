---
import '../../styles/global.css';

const apiBase = (import.meta.env.PUBLIC_API_URL as string | undefined)?.replace(/\/$/, '') ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f1f1f1" />
    <title>Panel — Angside</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div id="panel" data-api={apiBase}>
      <p id="boot" class="boot mono">Cargando…</p>

      <!-- Inicio de sesión -->
      <section id="login" class="login" hidden>
        <form id="login-form" class="card login-card" autocomplete="on" novalidate>
          <img src="/brand/logo_horizontal_light.svg" alt="Angside" class="logo" width="132" height="28" />
          <h1 class="title">Acceso al panel</h1>
          <p class="hint">Ingresa con tu usuario y contraseña.</p>
          <label>Usuario
            <input name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required />
          </label>
          <label>Contraseña
            <span class="pw">
              <input name="password" type="password" autocomplete="current-password" required />
              <button type="button" id="pw-toggle" class="ghost" aria-pressed="false">Mostrar</button>
            </span>
          </label>
          <p id="login-error" class="error" role="alert" aria-live="assertive"></p>
          <button type="submit" id="login-submit" class="btn btn-dark">Entrar</button>
        </form>
        <p id="no-api" class="hint" hidden>El panel necesita que el backend esté configurado (PUBLIC_API_URL).</p>
      </section>

      <!-- Panel -->
      <div id="app" hidden>
        <header class="bar">
          <img src="/brand/logo_horizontal_light.svg" alt="Angside" class="logo" width="110" height="24" />
          <nav id="tabs" class="tabs" aria-label="Secciones" hidden>
            <button type="button" data-tab="overview" aria-current="page">Resumen</button>
            <button type="button" data-tab="leads">Prospectos</button>
            <button type="button" data-tab="quotes">Cotizaciones</button>
          </nav>
          <div class="who">
            <span id="who-name" class="mono"></span>
            <button type="button" id="logout" class="ghost">Salir</button>
          </div>
        </header>

        <main class="main">
          <p id="notice" class="notice" role="status" hidden></p>
          <section id="view-overview" data-view="overview"></section>
          <section id="view-leads" data-view="leads" hidden>
            <form id="filters" class="filters" role="search">
              <input id="f-q" type="search" placeholder="Buscar por nombre, negocio, correo o teléfono" aria-label="Buscar prospectos" />
              <select id="f-status" aria-label="Filtrar por estado"><option value="">Todos los estados</option></select>
            </form>
            <div id="leads-table"></div>
            <div id="leads-pager" class="pager"></div>
          </section>
          <section id="view-quotes" data-view="quotes" hidden>
            <div id="quotes-table"></div>
            <div id="quotes-pager" class="pager"></div>
          </section>
          <section id="view-client" data-view="client" hidden>
            <div class="card pad">
              <h2 class="h2">Tu portal de cliente</h2>
              <p class="lead">Muy pronto podrás ver aquí tu mensualidad y el estado de tus servicios.</p>
            </div>
          </section>
        </main>

        <aside id="drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" hidden>
          <div class="drawer-bg" data-close></div>
          <div class="drawer-box">
            <header class="drawer-head">
              <h2 id="drawer-title" class="h2"></h2>
              <button type="button" class="ghost" data-close>Cerrar</button>
            </header>
            <div id="drawer-body" class="drawer-body"></div>
          </div>
        </aside>
      </div>
    </div>

    <script>
      import '../../scripts/panel';
    </script>
  </body>
</html>

<style is:global>
  #panel { min-height: 100dvh; }
  #panel .boot { padding: 40px; text-align: center; }
  #panel h1, #panel h2, #panel h3 { margin: 0; }
  #panel .title { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
  #panel .hint { margin: 0; color: var(--color-muted); font-size: 12.5px; }
  #panel .error { margin: 0; min-height: 18px; color: #b3261e; font-size: 12.5px; }
  #panel .pad { padding: 20px; }
  #panel .ghost { background: none; border: 0; padding: 6px 8px; font-size: 12px; font-weight: 600; color: var(--color-muted); border-radius: 3px; min-height: 36px; }
  #panel .ghost:hover { color: var(--color-charcoal); background: rgba(14, 17, 20, 0.05); }
  #panel input, #panel select, #panel textarea {
    width: 100%; box-sizing: border-box; min-height: 42px; padding: 0 12px; font: inherit; font-size: 14px;
    background: #fff; color: var(--color-charcoal); border: 1px solid var(--color-line); border-radius: 3px;
  }
  #panel textarea { padding: 10px 12px; min-height: 96px; resize: vertical; }
  #panel input:focus, #panel select:focus, #panel textarea:focus { outline: 2px solid var(--color-blue); outline-offset: 0; border-color: var(--color-blue); }
  #panel label { display: grid; gap: 6px; font-size: 12px; font-weight: 600; color: var(--color-graphite); }

  /* Login */
  .login { min-height: 100dvh; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 24px 16px; }
  .login-card { width: min(380px, 100%); padding: 28px; display: grid; gap: 14px; box-sizing: border-box; }
  .login-card .logo { margin-bottom: 4px; }
  .pw { display: grid; grid-template-columns: 1fr auto; gap: 6px; align-items: center; }
  .login-card .btn { width: 100%; }

  /* Barra superior */
  .bar { display: flex; align-items: center; gap: 20px; padding: 10px var(--gutter); background: #fff; border-bottom: 1px solid var(--color-line); position: sticky; top: 0; z-index: 5; }
  .tabs { display: flex; gap: 4px; flex: 1; overflow-x: auto; }
  .tabs button { background: none; border: 0; padding: 10px 14px; font-size: 13px; font-weight: 600; color: var(--color-muted); border-bottom: 2px solid transparent; min-height: 44px; }
  .tabs button[aria-current='page'] { color: var(--color-charcoal); border-bottom-color: var(--color-blue); }
  .who { display: flex; align-items: center; gap: 8px; margin-left: auto; }

  .main { max-width: 1180px; margin: 0 auto; padding: 24px var(--gutter) 60px; }
  .notice { margin: 0 0 14px; padding: 10px 14px; background: #fff; border: 1px solid var(--color-line); border-left: 3px solid var(--color-blue); border-radius: 3px; font-size: 13px; }

  /* Resumen */
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .kpi { padding: 16px; display: grid; gap: 6px; }
  .kpi strong { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
  .kpi small { color: var(--color-muted); font-size: 11.5px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .box { padding: 18px; display: grid; gap: 12px; align-content: start; }
  .box h3 { font-size: 13px; font-weight: 700; }
  .bars { display: grid; gap: 10px; }
  .bar-row { display: grid; grid-template-columns: 130px 1fr 32px; gap: 10px; align-items: center; font-size: 12.5px; }
  .track { height: 6px; background: var(--color-bg); border-radius: 3px; overflow: hidden; }
  .fill { height: 100%; background: var(--color-charcoal); }
  .bar-row .num { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }

  /* Tablas */
  .filters { display: grid; grid-template-columns: 1fr 220px; gap: 10px; margin-bottom: 14px; }
  .table-wrap { overflow-x: auto; }
  table.t { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 760px; }
  table.t th { text-align: left; padding: 10px 12px; font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); border-bottom: 1px solid var(--color-line); white-space: nowrap; }
  table.t td { padding: 12px; border-bottom: 1px solid var(--color-bg); vertical-align: top; }
  table.t tbody tr[data-id] { cursor: pointer; }
  table.t tbody tr[data-id]:hover { background: #fafafa; }
  table.t td small { display: block; color: var(--color-muted); font-size: 11.5px; }
  .pill { display: inline-block; padding: 2px 8px; border: 1px solid var(--color-line); border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap; }
  .pill.on { border-color: var(--color-blue); color: var(--color-blue-ink); }
  .empty { padding: 36px; text-align: center; color: var(--color-muted); }
  .pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-top: 12px; font-size: 12px; color: var(--color-muted); }
  .pager button { background: #fff; border: 1px solid var(--color-line); border-radius: 3px; padding: 0 14px; min-height: 36px; font-size: 12px; font-weight: 600; }
  .pager button:disabled { opacity: .4; cursor: default; }

  /* Detalle */
  .drawer { position: fixed; inset: 0; z-index: 20; display: flex; justify-content: flex-end; }
  .drawer-bg { position: absolute; inset: 0; background: rgba(14, 17, 20, 0.45); }
  .drawer-box { position: relative; width: min(640px, 100%); height: 100%; background: var(--color-bg); display: flex; flex-direction: column; box-shadow: -8px 0 24px rgba(0, 0, 0, 0.12); }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 20px; background: #fff; border-bottom: 1px solid var(--color-line); }
  .drawer-body { overflow-y: auto; padding: 20px; display: grid; gap: 14px; align-content: start; }
  .dl { display: grid; grid-template-columns: 140px 1fr; gap: 6px 12px; margin: 0; font-size: 13px; }
  .dl dt { color: var(--color-muted); }
  .dl dd { margin: 0; overflow-wrap: anywhere; }
  .chat { display: grid; gap: 8px; }
  .msg { padding: 8px 12px; border-radius: 6px; font-size: 13px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .msg.user { background: #eaf1ff; justify-self: end; max-width: 92%; }
  .msg.assistant { background: #fff; border: 1px solid var(--color-line); max-width: 92%; }
  .msg time { display: block; margin-top: 4px; font-size: 10.5px; color: var(--color-muted); }
  .props { display: grid; gap: 8px; }
  .prop { padding: 10px 12px; border: 1px solid var(--color-line); border-radius: 3px; background: #fff; font-size: 12.5px; display: grid; gap: 4px; }
  .row-actions { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: end; }

  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; gap: 8px; }
    .tabs { order: 3; flex-basis: 100%; }
    .filters { grid-template-columns: 1fr; }
    .dl { grid-template-columns: 1fr; }
    .dl dd { margin-bottom: 6px; }
    .bar-row { grid-template-columns: 100px 1fr 28px; }
  }
</style>
