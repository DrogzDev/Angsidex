---
import Icon from '../Icon.astro';

/** Invitación a consultar con la IA, visible en el cotizador. Solo aparece si hay backend configurado. */
const enabled = !!import.meta.env.PUBLIC_API_URL;
---

{enabled && (
  <div class="cta card">
    <div class="copy">
      <p class="mono">Asesor IA</p>
      <h3>¿No sabes qué necesita tu negocio?</h3>
      <p>Cuéntale a nuestra IA qué quieres construir y descubre qué soluciones podrían ayudarte.</p>
    </div>
    <button type="button" class="btn btn-dark" data-open-advisor>Consultar con IA <Icon name="arrow-right" size={14} /></button>
  </div>
)}

<style>
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 18px; margin-bottom: 20px; flex-wrap: wrap; }
  h3 { margin: 4px 0 4px; font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  p { margin: 0; font-size: 12px; color: var(--color-muted); max-width: 34rem; line-height: 1.45; }
  .copy .mono { font-size: 10px; color: var(--color-blue-ink); }
  .btn { min-height: 44px; flex: none; }
  @media (max-width: 560px) { .btn { width: 100%; } }
</style>
