---
import Icon from '../Icon.astro';
import { defaultCommercialConfig, paymentCopy } from '../../data/commercial';
import { modeLabel } from '../../lib/payment-plans';

// Los textos de las tarjetas se vuelven a calcular en el navegador con la configuración vigente de Django.
const modes = ['cash', ...defaultCommercialConfig.plans.map((p) => p.id)] as const;
---

<aside class="sum card" aria-labelledby="sum-title" id="quote-summary">
  <p class="mono" id="sum-title">Tu presupuesto estimado</p>

  <dl class="totals">
    <div>
      <dt class="mono" id="out-dev-label">Desarrollo · 2 pagos</dt>
      <dd id="out-dev" aria-live="polite">$0 USD</dd>
      <dd class="pay" id="out-pay" hidden>
        <p><span>Para arrancar el desarrollo</span><b id="out-pay-start"></b></p>
        <p><span>Al culminar, con todo funcionando</span><b id="out-pay-end"></b></p>
      </dd>
    </div>
    <div>
      <dt class="mono">Mensual · recurrente</dt>
      <dd id="out-month" aria-live="polite">$0 USD<small>/mes</small></dd>
    </div>
  </dl>

  <section class="pay-box" id="pay-box" aria-labelledby="pay-title" hidden>
    <p class="mono" id="pay-title">Modalidad de pago</p>
    <div class="modes" role="radiogroup" aria-labelledby="pay-title">
      {modes.map((m) => (
        <button type="button" role="radio" aria-checked="false" class="mode" data-mode={m}>
          <span class="mn">{modeLabel(m, defaultCommercialConfig)}</span>
          <span class="mp" data-mode-sub></span>
        </button>
      ))}
    </div>
    <div class="pay-detail" id="pay-detail" aria-live="polite"></div>
    <ol class="sched" id="pay-sched" hidden></ol>
    <p class="pay-note" id="pay-note">{paymentCopy.approvalFine}</p>
  </section>

  <ul class="lines" id="out-lines"></ul>
  <p class="empty" id="out-empty">Elige un tipo de proyecto para empezar.</p>

  <div class="monthly" id="out-monthly" hidden></div>

  <div class="ai-line" id="out-ai" hidden>
    <span class="mono">Consumo de IA · aparte</span>
    <p id="out-ai-text"></p>
  </div>

  <p class="warn" id="out-warn" role="status" hidden></p>

  <button type="button" class="btn btn-dark" id="btn-send" disabled>
    Hablar con Angside por WhatsApp <Icon name="message-circle" size={14} />
  </button>
  <div class="row">
    <button type="button" class="btn sm" id="btn-copy"><Icon name="copy" size={13} /> Copiar presupuesto</button>
    <button type="button" class="btn sm" id="btn-share"><Icon name="link" size={13} /> Compartir enlace</button>
  </div>
  <button type="button" class="reset" id="btn-reset">Reiniciar</button>
  <p class="status mono" id="out-status" role="status" aria-live="polite"></p>
  <p class="fine">Estimado inicial sujeto a alcance. Dominio, hosting, mantenimiento y servicios de terceros se presupuestan por separado del desarrollo. Una vez completado el pago, el sistema es 100 % tuyo.</p>
</aside>

<style>
  .sum { padding: 16px; display: flex; flex-direction: column; gap: 12px; position: sticky; top: calc(var(--nav-h) + 16px); box-sizing: border-box; max-height: calc(100dvh - var(--nav-h) - 32px); overflow-y: auto; overscroll-behavior: contain; }
  .sum[hidden] { display: none; }

  /* Selector de modalidad de pago: tarjetas discretas; el azul se reserva para la selección */
  .pay-box { display: grid; gap: 8px; padding-top: 10px; border-top: 1px solid var(--color-line); }
  .pay-box[hidden] { display: none; }
  .pay-box > .mono { margin: 0; font-size: 9px; }
  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .mode {
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 3px; text-align: left;
    padding: 8px 9px; min-height: 44px; display: flex; flex-direction: column; gap: 2px; box-sizing: border-box;
    transition: border-color .2s, background-color .2s;
  }
  .mode:hover { border-color: var(--color-charcoal); }
  .mode[aria-checked='true'] { border-color: var(--color-blue); background: #eaf1ff; }
  .mode[aria-checked='true'] .mn { color: var(--color-blue-ink); }
  .mode:disabled { opacity: .5; cursor: not-allowed; }
  .mn { font-size: 12px; font-weight: 700; }
  .mp { font-size: 10.5px; color: var(--color-muted); line-height: 1.3; }
  .pay-detail { display: grid; gap: 3px; font-size: 11.5px; }
  .pay-detail :global(div) { display: flex; justify-content: space-between; gap: 10px; }
  .pay-detail :global(div span:last-child) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pay-detail :global(.muted) { color: var(--color-muted); }
  .pay-detail :global(.neg span:last-child) { color: var(--color-charcoal); }
  .pay-detail :global(.total) { font-weight: 700; padding-top: 4px; margin-top: 2px; border-top: 1px solid var(--color-line); }
  .pay-detail :global(.alert) { display: block; color: #5c4a14; background: #fff7e6; border: 1px solid #ecd9a8; border-radius: 3px; padding: 6px 8px; }
  .sched { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: 11px; }
  .sched[hidden] { display: none; }
  .sched :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 10px; }
  .sched :global(li small) { grid-column: 1; color: var(--color-muted); font-size: 10px; }
  .sched :global(li b) { grid-row: 1 / span 2; grid-column: 2; font-weight: 600; font-variant-numeric: tabular-nums; align-self: center; }
  .pay-note { margin: 0; font-size: 10.5px; line-height: 1.4; color: var(--color-muted); }

  .ai-line { border-top: 1px solid var(--color-line); padding-top: 10px; display: grid; gap: 3px; }
  .ai-line[hidden] { display: none; }
  .ai-line .mono { font-size: 9px; }
  .ai-line p { margin: 0; font-size: 11.5px; line-height: 1.4; }
  .totals { margin: 0; display: grid; gap: 10px; }
  .totals dt { margin-bottom: 2px; font-size: 9px; }
  .totals dd { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .totals div:last-child dd { font-size: 20px; color: var(--color-blue); }
  .totals dd.pay { margin-top: 6px; display: grid; gap: 2px; font-size: 11px; font-weight: 400; letter-spacing: 0; line-height: 1.4; color: var(--color-muted); }
  .pay p { margin: 0; display: flex; justify-content: space-between; gap: 10px; }
  .pay b { font-weight: 600; color: var(--color-charcoal); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .totals small { font-size: 12px; font-weight: 600; color: var(--color-muted); margin-left: 2px; }
  .lines { list-style: none; margin: 0; padding: 10px 0 0; border-top: 1px solid var(--color-line); display: grid; gap: 6px; font-size: 11.5px; }
  .lines:empty { display: none; }
  .lines :global(li) { display: flex; justify-content: space-between; gap: 12px; }
  .lines :global(li span:last-child) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lines :global(li.dep) { color: var(--color-muted); }
  .empty { margin: 0; font-size: 12px; color: var(--color-muted); }
  .monthly { font-size: 11.5px; display: grid; gap: 4px; border-top: 1px solid var(--color-line); padding-top: 10px; }
  .monthly :global(div) { display: flex; justify-content: space-between; gap: 12px; }
  .warn { margin: 0; font-size: 11.5px; line-height: 1.4; padding: 8px 10px; background: #fff7e6; border: 1px solid #ecd9a8; border-radius: 3px; color: #5c4a14; }
  #btn-send { width: 100%; min-height: 44px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sm { min-height: 36px; padding: 0 8px; font-size: 11px; background: #fff; border-color: var(--color-line); gap: 6px; }
  .sm:hover { border-color: var(--color-charcoal); }
  .reset { background: none; border: 0; font-size: 11.5px; color: var(--color-muted); text-decoration: underline; justify-self: start; padding: 4px 0; }
  .status { margin: 0; min-height: 1.2em; color: var(--color-blue-ink); text-transform: none; }
  .fine { margin: 0; font-size: 10.5px; color: var(--color-muted); line-height: 1.4; }

  @media (max-width: 1023px) { .sum { position: static; max-height: none; overflow: visible; } }
</style>
