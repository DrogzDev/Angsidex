---
import { faqs } from '../../data/faq';
---

<section id="preguntas" class="section">
  <div class="container">
    <div class="section-head">
      <p class="mono label"><b>FAQ</b><span>Preguntas</span><span>frecuentes</span></p>
      <h2 class="h2">Lo que más nos preguntan antes de empezar.</h2>
    </div>
    <div class="list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list { display: grid; gap: 0; max-width: 52rem; margin-left: auto; }
  details { border-bottom: 1px solid var(--color-line); }
  details:first-child { border-top: 1px solid var(--color-line); }
  summary { cursor: pointer; padding: 16px 28px 16px 0; font-size: 14px; font-weight: 600; list-style: none; position: relative; min-height: 24px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 14px; font-size: 18px; font-weight: 400; color: var(--color-muted); }
  details[open] summary::after { content: '−'; }
  p { margin: 0 0 16px; max-width: 42rem; font-size: 13px; line-height: 1.6; color: var(--color-muted); }
  @media (max-width: 767px) { .list { max-width: none; } }
</style>
