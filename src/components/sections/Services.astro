---
import Icon from '../Icon.astro';
import { services } from '../../data/services';
---

<section id="servicios" class="section">
  <div class="container">
    <div class="section-head">
      <p class="mono label"><b>01</b><span>Servicios</span></p>
      <div class="head-main">
        <h2 class="h2">Lo que podemos construir para tu negocio</h2>
        <p class="lead aside">Sitios web, tiendas, sistemas y automatizaciones. Todo adaptado a la realidad de Venezuela.</p>
      </div>
    </div>

    <ul class="grid">
      {services.map((s) => (
        <li>
          <a href={`#calculadora`} class="card svc" data-service={s.baseId}>
            <Icon name={s.icon} size={22} class="svc-ico" />
            <h3>{s.name}</h3>
            <p>{s.description}</p>
            <div class="foot">
              <div>
                <span class="mono">Desde</span>
                <strong>${s.from} USD</strong>
              </div>
              <Icon name="arrow-right" size={16} class="arrow" />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head-main { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .aside { max-width: 22rem; font-size: 11.5px; text-align: right; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-left: 132px; }
  .svc { display: flex; flex-direction: column; height: 100%; padding: 16px 16px 14px; box-sizing: border-box; transition: border-color .2s, transform .2s; }
  .svc:hover { border-color: var(--color-charcoal); }
  .svc :global(.svc-ico) { margin-bottom: 14px; }
  h3 { margin: 0 0 4px; font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  p { margin: 0; font-size: 12px; color: var(--color-muted); line-height: 1.4; }
  .foot { margin-top: auto; padding-top: 14px; display: flex; align-items: end; justify-content: space-between; }
  .foot .mono { display: block; font-size: 8.5px; }
  .foot strong { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; }
  .svc :global(.arrow) { transition: transform .2s; }
  .svc:hover :global(.arrow) { transform: translateX(4px); }

  @media (max-width: 1100px) { .grid { margin-left: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .aside { text-align: left; } }
  @media (max-width: 359px) { .grid { grid-template-columns: 1fr; } }
</style>
