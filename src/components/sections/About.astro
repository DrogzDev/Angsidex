---
import Icon from '../Icon.astro';

const values = [
  { icon: 'layers', title: 'Diseño funcional', text: 'Interfaces claras, pensadas para usarse.' },
  { icon: 'handshake', title: 'Trato directo', text: 'Comunicación cercana durante todo el proyecto.' },
  { icon: 'trending-up', title: 'Soluciones escalables', text: 'Base sólida para crecer contigo.' },
  { icon: 'headset', title: 'Soporte y evolución', text: 'Seguimos mejorando después del lanzamiento.' },
];
---

<section id="nosotros" class="section">
  <div class="container">
    <div class="section-head">
      <p class="mono label"><b>02</b><span>Quiénes somos</span></p>
      <div class="about">
        <div class="text">
          <h2 class="display title">
            Un estudio<br />de desarrollo<br />que piensa en<br /><span class="accent">tu crecimiento</span>
          </h2>
          <p class="lead body">
            En Angside combinamos diseño, tecnología y estrategia para desarrollar soluciones digitales prácticas, escalables y adaptadas a las necesidades reales de cada negocio.
          </p>
        </div>
        <ul class="values">
          {values.map((v) => (
            <li>
              <Icon name={v.icon} size={18} />
              <b>{v.title}</b>
              <span>{v.text}</span>
            </li>
          ))}
        </ul>
        <figure class="photo">
          <img src="/media/estudio.webp" alt="Estudio de Angside: un equipo con iluminación y dos monitores mostrando el sitio de Angside" width="1600" height="1200" loading="lazy" decoding="async" />
          <figcaption class="mono">Nuestro estudio</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .title { font-size: clamp(2.1rem, 3.5vw, 3.2rem); line-height: 0.98; }
  .body { margin-top: 16px; font-size: 12.5px; max-width: 28rem; }
  .values { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px 18px; }
  .values li { display: grid; gap: 4px; align-content: start; }
  .values b { font-size: 12.5px; font-weight: 600; }
  .values span { font-size: 11.5px; color: var(--color-muted); line-height: 1.4; }
  .photo { margin: 0; }
  .photo img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; background: var(--color-graphite); }
  .photo figcaption { margin-top: 8px; }
  @media (max-width: 1100px) { .about { grid-template-columns: 1fr 1fr; } .photo { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .about { grid-template-columns: 1fr; } }
</style>
