# Copia a .env (NO lo subas al repositorio) y completa los valores.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=angside
POSTGRES_USER=angside
# Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Túnel de Cloudflare ---
# Token del túnel "angside-api" (dashboard de Cloudflare → Networking → Tunnels). Solo vive en el VPS.
TUNNEL_TOKEN=

# --- Django ---
DJANGO_DEBUG=false
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.angsidex.com
# Ruta del admin de Django (cámbiala por algo no obvio, p. ej. panel-x7k2/)
DJANGO_ADMIN_URL=admin/
# El túnel termina TLS en Cloudflare; el redirect HTTPS lo hace Cloudflare, no el origen.
DJANGO_SSL_REDIRECT=false
# Origen del frontend (CORS con credenciales + CSRF)
ALLOWED_ORIGINS=https://angsidex.com
# Solo el túnel llega al contenedor, así que se puede confiar en CF-Connecting-IP
TRUST_CF_CONNECTING_IP=true

# --- Turnstile / IA ---
TURNSTILE_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash-20260826
AI_SITE_URL=https://angsidex.com
AI_DAILY_BUDGET_USD=2.00
AI_MONTHLY_BUDGET_USD=30.00
PRIVACY_POLICY_VERSION=2026-10

# --- Opcional ---
# IMAGE_TAG=2026-10-26   # para poder volver a una imagen anterior
