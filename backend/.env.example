# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=api.tudominio.com
# Dominio(s) del sitio que pueden llamar a la API (separados por coma)
ALLOWED_ORIGINS=https://tudominio.com
# Activar solo si el servidor recibe tráfico únicamente a través de Cloudflare
TRUST_CF_CONNECTING_IP=false

# Cloudflare Turnstile (secret key). Prueba: 1x0000000000000000000000000000000AA (siempre pasa)
TURNSTILE_SECRET=

# OpenRouter
OPENROUTER_API_KEY=
# Debe soportar herramientas (tools) y salida estructurada. Cambiarlo no requiere tocar el frontend.
OPENROUTER_MODEL=z-ai/glm-5.3-flash-20260826
# Esfuerzo de razonamiento de GLM (low/medium/high; vacío = por defecto del proveedor)
AI_REASONING_EFFORT=low
OPENROUTER_FALLBACK_MODELS=
AI_SITE_URL=https://tudominio.com

# Límites y presupuesto (USD)
AI_MAX_USER_MESSAGES_PER_SESSION=20
AI_MAX_TOKENS_PER_SESSION=80000
AI_MAX_COST_PER_SESSION_USD=0.06
AI_MAX_TOKENS_PER_IP_DAY=200000
AI_MAX_COST_PER_IP_DAY_USD=0.12
AI_MAX_OFFTOPIC_STRIKES=3
AI_MAX_OUTPUT_TOKENS=1500
AI_DAILY_BUDGET_USD=0.50
AI_MONTHLY_BUDGET_USD=3.00

PRIVACY_POLICY_VERSION=2026-10
